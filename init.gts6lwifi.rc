import /vendor/etc/init/hw/init.${ro.hardware}.usb.rc

on init
    write /sys/block/zram0/comp_algorithm lz4

    symlink /sdcard /storage/sdcard0

    # Boot-time cpusets; narrowed once boot completes
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/background/cpus 0-7
    write /dev/cpuset/system-background/cpus 0-7
    write /dev/cpuset/top-app/cpus 0-7

on early-fs
    mkdir /mnt/vendor/apnhlos 0755 root root

on fs
    mount_all /vendor/etc/fstab.${ro.hardware} --early

    # The remote processors started (and failed) before their firmware was
    # mounted: start them now, all but the modem, which rmtfs starts
    start gts6lwifi_rproc

on post-fs
    # RLIMIT_MEMLOCK to 64 MiB
    setrlimit 8 67108864 67108864

on late-fs
    mount_all /vendor/etc/fstab.${ro.hardware} --late

on post-fs-data
    # rmtfs and tqftpserv serve the modem (which also runs the WLAN firmware)
    mkdir /data/vendor/tmp
    mkdir /data/vendor/readwrite
    mkdir /data/vendor/readonly
    mkdir /data/vendor/readonly/firmware
    mkdir /data/vendor/readonly/firmware/image
    start tqftpserv
    start rmtfs

on zygote-start
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on early-boot
    mount debugfs debugfs /sys/kernel/debug
    chmod 755 /sys/kernel/debug
    chown graphics graphics /sys/kernel/debug/sync/sw_sync
    chmod 777 /sys/kernel/debug/sync/sw_sync
    chown graphics graphics /sys/kernel/debug/sync/info

on property:sys.boot_completed=1
    # Kryo 485: cores 0-3 are the small ones, 4-6 big, 7 the prime core
    write /dev/cpuset/foreground/cpus 0-6
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/background/cpus 0-1
    write /dev/cpuset/system-background/cpus 0-3
    trigger sys-boot-completed-set

on sys-boot-completed-set && property:persist.sys.zram_enabled=1
    swapon_all /vendor/etc/fstab.${ro.hardware}

on shutdown
    stop rmtfs

service gts6lwifi_rproc /vendor/bin/init.gts6lwifi.rproc.sh
    user root
    group system
    disabled
    oneshot

# -s: rmtfs starts the modem (and the WLAN firmware with it) once it serves
# the modem's file system
service rmtfs /vendor/bin/rmtfs -o /dev/block/by-name -P -r -s
    class core
    user root
    group system
    disabled
    oneshot

service tqftpserv /vendor/bin/tqftpserv
    class core
    user root
    group system
    disabled
    oneshot

service suspend_blocker /vendor/bin/suspend_blocker
    class early_hal
    user root
    group system
