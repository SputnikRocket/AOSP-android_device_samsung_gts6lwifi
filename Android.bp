soong_namespace {
}

package {
    default_applicable_licenses: ["device_samsung_gts6lwifi_license"],
}

license {
    name: "device_samsung_gts6lwifi_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

// Adreno 640 GMU firmware and the Adreno 630 SQE microcode (a630_sqe.fw,
// shared by the A6xx family), from linux-firmware.
license_kind {
    name: "device_samsung_gts6lwifi_LICENSE_qcom",
    conditions: ["notice", "proprietary"], // by exception only
}

license {
    name: "device_samsung_gts6lwifi_firmware_license",
    package_name: "Linux Firmware",
    visibility: [":__subpackages__"],
    license_kinds: ["device_samsung_gts6lwifi_LICENSE_qcom"],
    license_text: [
        "firmware/LICENSE.qcom",
        "firmware/NOTICE.qcom",
    ],
}

prebuilt_firmware {
    name: "a640_gmu.bin",
    licenses: ["device_samsung_gts6lwifi_firmware_license"],
    vendor: true,
    src: "firmware/a640_gmu.bin",
    relative_install_path: "qcom",
}

// The Adreno 630/640 SQE microcode, from linux-firmware (as in the Linaro
// vendor package, whose namespace this device doesn't export; see device.mk)
prebuilt_firmware {
    name: "gts6lwifi_a630_sqe.fw",
    licenses: ["device_samsung_gts6lwifi_firmware_license"],
    vendor: true,
    src: "firmware/a630_sqe.fw",
    filename: "a630_sqe.fw",
    relative_install_path: "qcom",
}

license_kind {
    name: "device_samsung_gts6lwifi_LICENSE_QualcommAtheros_ath10k",
    conditions: ["notice", "by_exception_only", "proprietary"],
}

license {
    name: "device_samsung_gts6lwifi_ath10k_license",
    package_name: "Linux Firmware",
    visibility: [":__subpackages__"],
    license_kinds: ["device_samsung_gts6lwifi_LICENSE_QualcommAtheros_ath10k"],
    license_text: ["firmware/LICENSE.QualcommAtheros_ath10k"],
}

// ath10k's description (firmware features) of the WCN3990 family's WLAN
// firmware, from linux-firmware
prebuilt_firmware {
    name: "gts6lwifi_firmware-5.bin",
    licenses: ["device_samsung_gts6lwifi_ath10k_license"],
    vendor: true,
    src: "firmware/firmware-5.bin",
    filename: "firmware-5.bin",
    relative_install_path: "ath10k/WCN3990/hw1.0",
}

license {
    name: "device_samsung_gts6lwifi_regdb_license",
    package_name: "wireless-regdb",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-ISC"],
    license_text: ["firmware/LICENSE.wireless-regdb"],
}

// The regulatory database cfg80211 reads (the WCN3998's WLAN driver, ath10k,
// has none of its own): without it the kernel keeps the world regulatory
// domain, with 5 GHz passive only. wireless-regdb, unsigned (the kernel
// doesn't require the signature).
prebuilt_firmware {
    name: "gts6lwifi_regulatory.db",
    licenses: ["device_samsung_gts6lwifi_regdb_license"],
    vendor: true,
    src: "firmware/regulatory.db",
    filename: "regulatory.db",
}

// wpa_supplicant's configuration, generated by wpa_supplicant_8; the SoC
// vendors' Wi-Fi trees define this module for their own BOARD_WLAN_DEVICE,
// and nothing does for an upstream driver.
prebuilt_etc {
    name: "wpa_supplicant.conf",
    licenses: ["external_wpa_supplicant_8_license"],
    vendor: true,
    src: ":wpa_supplicant_conf_gen",
    sub_dir: "wifi",
}

// The Bluetooth address, run by db845c's set_bdaddr service (bdaddr.rc)
sh_binary {
    name: "set_bdaddr.sh",
    vendor: true,
    src: "set_bdaddr.sh",
}

// Starts the remote processors other than the modem (init.gts6lwifi.rc)
sh_binary {
    name: "init.gts6lwifi.rproc.sh",
    vendor: true,
    src: "init.gts6lwifi.rproc.sh",
}

// The remote processor firmware and the GPU zap shader are signed for this
// device and stay on its firmware partition (apnhlos), which init mounts at
// /mnt/vendor/apnhlos. The kernel loads them from firmware_class.path
// (/vendor/firmware) as qcom/sm8150/samsung/gts6lwifi/<name>.mdt.
install_symlink {
    name: "gts6lwifi_apnhlos_firmware",
    vendor: true,
    installed_location: "firmware/qcom/sm8150/samsung/gts6lwifi",
    symlink_target: "/mnt/vendor/apnhlos/image",
}
