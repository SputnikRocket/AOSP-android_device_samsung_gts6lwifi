# init.gts6lwifi.rproc.sh: starts the remote processors, other than the
# modem, once their firmware is mounted
type gts6lwifi_rproc, domain;
type gts6lwifi_rproc_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(gts6lwifi_rproc)

allow gts6lwifi_rproc vendor_shell_exec:file rx_file_perms;
allow gts6lwifi_rproc vendor_toolbox_exec:file rx_file_perms;
allow gts6lwifi_rproc sysfs_remoteproc:dir r_dir_perms;
allow gts6lwifi_rproc sysfs_remoteproc:file rw_file_perms;
allow gts6lwifi_rproc sysfs:dir r_dir_perms;
allow gts6lwifi_rproc sysfs:lnk_file read;
