subsystem usbmisc
    devname uevent_devname

/dev/sw_sync              0660   root       graphics

# card0 is simpledrm (the bootloader's splash) until the MSM display driver
# replaces it; the MSM driver is card1.
/dev/dri/card0            0660   system     graphics
/dev/dri/card1            0660   system     graphics
/dev/dri/renderD128       0666   system     graphics

/dev/qcom_rmtfs_mem1      0660   system     system
